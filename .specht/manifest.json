{
  "schemaVersion": "0.2.0",
  "$comment": "Not a JSON Schema. The ordered section manifest Specht rule SPEC010 reads, kept as data so the section contract - the twelve numbered sections plus Tasks and Scoring - lives in one place rather than as a string array in C#.",
  "layouts": [
    {
      "name": "epics",
      "glob": "epics/**/spec.md",
      "identity": {
        "epic": 1,
        "feature": 2
      }
    },
    {
      "name": "features",
      "glob": "**/.spec/README.md"
    }
  ],
  "exclusions": [
    ".git",
    ".artifacts",
    ".skillfile",
    ".claude",
    "graphify-out",
    "bin",
    "obj",
    "node_modules",
    "/.spec"
  ],
  "taskFiles": [
    "{task}-*.md"
  ],
  "epicFiles": [
    "epics/**/epic.md"
  ],
  "companionFiles": [
    "*.feature"
  ],
  "sections": [
    "1. Business Goal",
    "2. User Needs",
    "3. Acceptance Criteria",
    "4. Constraints",
    "5. Out of Scope",
    "6. Concern Separation",
    "7. Technical Design",
    "8. Testing Strategy",
    "9. Traceability Matrix",
    "10. Lessons / Spec Deltas",
    "11. Open Questions",
    "12. Sign-off",
    "Tasks",
    "Scoring"
  ],
  "tables": {
    "matrix": [
      "Claim ID",
      "Scenario",
      "Test",
      "Status"
    ],
    "signOff": [
      "Section",
      "Status",
      "Reviewer",
      "Note"
    ]
  },
  "identifiers": {
    "claim": "^B-[0-9]{3}[a-z]?$",
    "constraint": "^C-[0-9]+$",
    "openQuestion": "^OQ-[0-9]+$",
    "task": "^[0-9]{4}-[0-9]{2}$",
    "feature": "^F[0-9]+[a-z]?$",
    "epic": "^[0-9]{4}$"
  },
  "frontmatterSchemas": {
    "feature": "feature.schema.json",
    "task": "task.schema.json",
    "epic": "epic.schema.json"
  },
  "roles": {
    "claims": "3. Acceptance Criteria",
    "matrix": "9. Traceability Matrix",
    "signOff": "12. Sign-off"
  },
  "markers": {
    "missing": "Missing",
    "draft": "🟡",
    "blocked": "🔴",
    "approved": "approved",
    "covered": "Covered",
    "partial": "Partial",
    "waived": "Waived",
    "withdrawn": "Withdrawn",
    "superseded": "Superseded"
  },
  "rules": {
    "SPEC060": "warning"
  },
  "claim": {
    "tag": "@{claim}",
    "tagIgnoreCase": false
  },
  "codeAnalysis": {
    "mappings": {
      "/schemaVersion": "/schemaVersion",
      "/identifiers": "/identifiers",
      "/markers": "/markers",
      "/claimsSection": "/roles/claims",
      "/policy": "/codeAnalysis"
    },
    "projects": [
      {
        "path": "src/analyzers/analyzers.csproj",
        "targetFrameworks": ["netstandard2.0"]
      }
    ],
    "features": [
      { "epic": "0201", "feature": "F1" }
    ],
    "enforcement": [],
    "records": {
      "adrProfiles": [
        {
          "glob": ".spec/adr/*.md",
          "owner": "repository",
          "identity": { "headingLevel": 1, "separator": ": " },
          "lifecycle": { "section": "Status", "firstWord": true }
        },
        {
          "glob": "src/**/.spec/adr/*.md",
          "owner": "containingFeature",
          "identity": { "headingLevel": 1, "separator": ": " },
          "lifecycle": { "section": "Status", "firstWord": true }
        },
        {
          "glob": "epics/**/adr/*.md",
          "owner": "containingFeature",
          "identity": { "headingLevel": 1, "separator": ": " },
          "lifecycle": { "section": "Status", "firstWord": true }
        }
      ]
    }
  },
  "tests": {
    "files": [
      "test/**/*.cs"
    ]
  },
  "owners": {
    "1. Business Goal": [
      "spec-author"
    ],
    "2. User Needs": [
      "spec-author"
    ],
    "3. Acceptance Criteria": [
      "spec-author"
    ],
    "4. Constraints": [
      "spec-author"
    ],
    "5. Out of Scope": [
      "spec-author"
    ],
    "6. Concern Separation": [
      "implementer"
    ],
    "7. Technical Design": [
      "implementer"
    ],
    "8. Testing Strategy": [
      "test-writer",
      "benchmarker"
    ],
    "9. Traceability Matrix": [
      "test-writer",
      "spec-author"
    ],
    "10. Lessons / Spec Deltas": [
      "spec-author"
    ],
    "11. Open Questions": [
      "spec-author",
      "test-writer",
      "implementer",
      "benchmarker",
      "spec-reviewer"
    ],
    "12. Sign-off": [
      "spec-reviewer"
    ],
    "Tasks": [
      "spec-author"
    ]
  }
}
