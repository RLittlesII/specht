{
  "schemaVersion": "0.4.0",
  "$comment": "Not a JSON Schema. The ordered section manifest Specht rule SPEC2001 reads, kept as data so the section contract - the twelve numbered sections plus Tasks and Scoring - lives in one place rather than as a string array in C#.",
  "layouts": [
    {
      "name": "epics",
      "glob": "epics/**/spec.md",
      "identity": {
        "epic": 1,
        "feature": 2
      }
    },
    {
      "name": "features",
      "glob": "**/.spec/README.md"
    }
  ],
  "exclusions": [
    ".git",
    ".artifacts",
    ".skillfile",
    ".claude",
    "graphify-out",
    "bin",
    "obj",
    "node_modules",
    "/.spec"
  ],
  "taskFiles": [
    "{task}-*.md"
  ],
  "epicFiles": [
    "epics/**/epic.md"
  ],
  "companionFiles": [
    "*.feature"
  ],
  "sections": [
    "1. Business Goal",
    "2. User Needs",
    "3. Acceptance Criteria",
    "4. Constraints",
    "5. Out of Scope",
    "6. Concern Separation",
    "7. Technical Design",
    "8. Testing Strategy",
    "9. Traceability Matrix",
    "10. Lessons / Spec Deltas",
    "11. Open Questions",
    "12. Sign-off",
    "Tasks",
    "Scoring"
  ],
  "tables": {
    "matrix": [
      "Claim ID",
      "Scenario",
      "Test",
      "Status"
    ],
    "signOff": [
      "Section",
      "Status",
      "Reviewer",
      "Note"
    ]
  },
  "identifiers": {
    "task": "^(?<epic>[0-9]{4})-(?<sequence>[0-9]{2})$",
    "feature": "^F[0-9]+[a-z]?$",
    "epic": "^[0-9]{4}$"
  },
  "keys": {
    "feature": {
      "id": "id",
      "epic": "epic",
      "specStatus": "spec_status",
      "status": "status",
      "children": "children",
      "spikes": "spikes",
      "dependsOn": "depends_on",
      "blocks": "blocks",
      "claimPrefix": "claim_prefix"
    },
    "task": {
      "id": "id",
      "parent": "parent",
      "type": "type"
    }
  },
  "forms": {
    "identity": "{epic}-{id}",
    "localEdge": "{id}",
    "qualifiedEdge": "{epic}/{id}"
  },
  "frontmatterSchemas": {
    "feature": "feature.schema.json",
    "task": "task.schema.json",
    "epic": "epic.schema.json"
  },
  "roles": {
    "claims": "3. Acceptance Criteria",
    "matrix": "9. Traceability Matrix",
    "signOff": "12. Sign-off"
  },
  "markers": {
    "missing": "Missing",
    "draft": "🟡",
    "blocked": "🔴",
    "approved": "approved",
    "done": "done",
    "covered": "Covered",
    "partial": "Partial",
    "waived": "Waived",
    "withdrawn": "Withdrawn",
    "superseded": "Superseded"
  },
  "rules": {},
  "claim": {
    "tag": "@{claim}",
    "tagIgnoreCase": false
  },
  "codeAnalysis": {
    "mappings": {
      "/schemaVersion": "/schemaVersion",
      "/identifiers": "/identifiers",
      "/ids/claim": "/ids/claim",
      "/markers": "/markers",
      "/claimsSection": "/roles/claims",
      "/policy": "/codeAnalysis"
    },
    "projects": [
      {
        "path": "src/analyzers/analyzers.csproj",
        "targetFrameworks": ["netstandard2.0"]
      },
      {
        "path": "src/specht/specht.csproj",
        "targetFrameworks": ["net10.0", "net11.0"]
      },
      {
        "path": "src/tool/tool.csproj",
        "targetFrameworks": ["net10.0", "net11.0"]
      }
    ],
    "features": [
      { "epic": "0201", "feature": "F1" },
      { "epic": "0201", "feature": "F7" },
      { "epic": "0001", "feature": "F1" },
      { "epic": "0001", "feature": "F2" }
    ],
    "enforcement": [
      {
        "project": "src/specht/specht.csproj",
        "include": ["src/specht/**/*.cs"],
        "exclude": [],
        "role": "implements",
        "declarationKinds": ["type", "constructor", "method"]
      },
      {
        "project": "src/tool/tool.csproj",
        "include": ["src/tool/**/*.cs"],
        "exclude": [],
        "role": "implements",
        "declarationKinds": ["type", "constructor", "method"]
      }
    ],
    "records": {
      "adrProfiles": [
        {
          "glob": ".spec/adr/*.md",
          "owner": "repository",
          "identity": { "headingLevel": 1, "separator": ": " },
          "lifecycle": { "section": "Status", "firstWord": true }
        },
        {
          "glob": "src/**/.spec/adr/*.md",
          "owner": "containingFeature",
          "identity": { "headingLevel": 1, "separator": ": " },
          "lifecycle": { "section": "Status", "firstWord": true }
        },
        {
          "glob": "epics/**/adr/*.md",
          "owner": "containingFeature",
          "identity": { "headingLevel": 1, "separator": ": " },
          "lifecycle": { "section": "Status", "firstWord": true }
        }
      ]
    }
  },
  "tests": {
    "files": [
      "test/**/*.cs",
      ".github/mirror/tests/test_*.py"
    ]
  },
  "owners": {
    "1. Business Goal": [
      "spec-author"
    ],
    "2. User Needs": [
      "spec-author"
    ],
    "3. Acceptance Criteria": [
      "spec-author"
    ],
    "4. Constraints": [
      "spec-author"
    ],
    "5. Out of Scope": [
      "spec-author"
    ],
    "6. Concern Separation": [
      "implementer"
    ],
    "7. Technical Design": [
      "implementer"
    ],
    "8. Testing Strategy": [
      "test-writer",
      "benchmarker"
    ],
    "9. Traceability Matrix": [
      "test-writer",
      "spec-author"
    ],
    "10. Lessons / Spec Deltas": [
      "spec-author"
    ],
    "11. Open Questions": [
      "spec-author",
      "test-writer",
      "implementer",
      "benchmarker",
      "spec-reviewer"
    ],
    "12. Sign-off": [
      "spec-reviewer"
    ],
    "Tasks": [
      "spec-author"
    ]
  },
  "ids": {
    "claim": {
      "form": "{prefix}{id}",
      "plain": "B-{id}",
      "id": "[0-9]{3}[a-z]?|[0-9a-hjkmnp-tv-z]{6}|[0-9a-hjkmnp-tv-z]{13}"
    },
    "constraint": {
      "plain": "C-{id}",
      "id": "[0-9]+|[0-9a-hjkmnp-tv-z]{6}|[0-9a-hjkmnp-tv-z]{13}"
    },
    "openQuestion": {
      "plain": "OQ-{id}",
      "id": "[0-9]+|[0-9a-hjkmnp-tv-z]{6}|[0-9a-hjkmnp-tv-z]{13}"
    },
    "scenario": {
      "plain": "S-{id}",
      "id": "[0-9]+|[0-9a-hjkmnp-tv-z]{6}|[0-9a-hjkmnp-tv-z]{13}"
    },
    "decision": {
      "plain": "{id}",
      "id": "[0-9]{4}|[0-9a-hjkmnp-tv-z]{6}|[0-9a-hjkmnp-tv-z]{13}"
    },
    "adr": {
      "plain": "{id}",
      "id": "[0-9]{4}|[0-9a-hjkmnp-tv-z]{8}|[0-9a-hjkmnp-tv-z]{13}"
    },
    "lesson": {
      "plain": "{id}",
      "id": "[0-9]{4}|[0-9a-hjkmnp-tv-z]{8}|[0-9a-hjkmnp-tv-z]{13}"
    }
  }
}
