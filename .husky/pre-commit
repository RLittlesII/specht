#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

staged=$(git -c core.quotePath=false diff --cached --name-only --diff-filter=AMR -- '*.cs' '*.md')

if [ -z "$staged" ]; then
    exit 0
fi

saved_ifs=$IFS
IFS='
'
set -f
set -- $staged
set +f
IFS=$saved_ifs

for file in "$@"; do
    case "$file" in
        \"*)
            echo "pre-commit: git quotes this staged name, so Format cannot match it: $file"
            echo "Rename it without a double quote, a backslash or a control character."
            echo
            echo "Bypass with: git commit --no-verify"
            exit 1
            ;;
    esac
done

top=$(git rev-parse --show-toplevel)
tmp=$(mktemp -d "${TMPDIR:-/tmp}/specht-pre-commit.XXXXXX")
trap 'rm -rf "$tmp"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP
tmp=$(cd "$tmp" && pwd -P)

git checkout-index -a --prefix="$tmp/"

if "$top/build.sh" Format --root "$tmp" --files "$@"; then
    exit 0
fi

prettier_version=$(sed -n 's/.*"prettier"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$tmp/package.json")
cs_files=""
md_files=""
for file in "$@"; do
    case "$file" in
        *.[cC][sS]) cs_files="$cs_files \"$file\"" ;;
        *) md_files="$md_files \"$file\"" ;;
    esac
done

echo
echo "pre-commit: Format rejected the staged content. The staged files it checked:"
echo
printf '    %s\n' "$@"
echo
echo "Paths in the log above are a temporary copy of the index; the files are the ones listed here."
echo
echo "Fix the working copy, then stage it again:"
echo
if [ -n "$cs_files" ]; then
    echo "    dotnet format specht.slnx --include$cs_files"
fi
if [ -n "$md_files" ]; then
    echo "    npx --yes prettier@$prettier_version --write$md_files"
fi
echo
echo "dotnet format without --verify-no-changes applies analyzer code fixes. If its diff"
echo "removes a [Theory] parameter, that is xUnit1026 - make the parameter used rather than"
echo "deleting it, or its data column is orphaned."
echo
echo "Bypass with: git commit --no-verify"
exit 1
