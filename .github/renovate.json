{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "ignorePaths": [".github/workflows/**"],
  "timezone": "America/Chicago",
  "schedule": ["before 6am on monday"],
  "labels": ["dependencies", "📦 dependencies"],
  "dependencyDashboard": false,
  "nuget": {
    "enabled": true
  },
  "github-actions": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "0055-F4 B-001: clear preset groups for central packages before applying package families.",
      "matchManagers": ["nuget"],
      "matchFileNames": ["Directory.Packages.props"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": null,
      "groupSlug": null
    },
    {
      "description": "0055-F4 B-001: group CodeAnalysis minor and patch updates.",
      "matchManagers": ["nuget"],
      "matchFileNames": ["Directory.Packages.props"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": [
        "Microsoft.CodeAnalysis",
        "Microsoft.CodeAnalysis.*"
      ],
      "groupName": "CodeAnalysis",
      "groupSlug": "nuget-codeanalysis"
    },
    {
      "description": "0055-F4 B-001: group Rocket.Surgery minor and patch updates.",
      "matchManagers": ["nuget"],
      "matchFileNames": ["Directory.Packages.props"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["Rocket.Surgery", "Rocket.Surgery.*"],
      "groupName": "Rocket.Surgery",
      "groupSlug": "nuget-rocket-surgery"
    },
    {
      "description": "0055-F4 B-001: group xUnit v3 minor and patch updates.",
      "matchManagers": ["nuget"],
      "matchFileNames": ["Directory.Packages.props"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["xunit.v3", "xunit.v3.*"],
      "groupName": "xUnit v3",
      "groupSlug": "nuget-xunit-v3"
    },
    {
      "description": "0055-F4 B-001: group Microsoft dependency injection minor and patch updates.",
      "matchManagers": ["nuget"],
      "matchFileNames": ["Directory.Packages.props"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": [
        "Microsoft.Extensions.DependencyInjection",
        "Microsoft.Extensions.DependencyInjection.*"
      ],
      "groupName": "Microsoft dependency injection",
      "groupSlug": "nuget-dependency-injection"
    },
    {
      "description": "0055-F4 B-001: group VSTest minor and patch updates.",
      "matchManagers": ["nuget"],
      "matchFileNames": ["Directory.Packages.props"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": [
        "Microsoft.NET.Test.Sdk",
        "Microsoft.TestPlatform.*"
      ],
      "groupName": "VSTest",
      "groupSlug": "nuget-vstest"
    },
    {
      "description": "0055-F4 B-001: group Reqnroll minor and patch updates.",
      "matchManagers": ["nuget"],
      "matchFileNames": ["Directory.Packages.props"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["Reqnroll", "Reqnroll.*"],
      "groupName": "Reqnroll",
      "groupSlug": "nuget-reqnroll"
    },
    {
      "description": "0055-F4 B-001: group Spectre.Console.Cli minor and patch updates.",
      "matchManagers": ["nuget"],
      "matchFileNames": ["Directory.Packages.props"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["Spectre.Console.Cli", "Spectre.Console.Cli.*"],
      "groupName": "Spectre.Console.Cli",
      "groupSlug": "nuget-spectre-cli"
    },
    {
      "description": "0055-F4 B-001: group TestableIO file-system abstractions minor and patch updates.",
      "matchManagers": ["nuget"],
      "matchFileNames": ["Directory.Packages.props"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": [
        "TestableIO.System.IO.Abstractions",
        "TestableIO.System.IO.Abstractions.*"
      ],
      "groupName": "TestableIO file-system abstractions",
      "groupSlug": "nuget-testableio"
    },
    {
      "description": "0055-F4 B-003: the .NET SDK global.json pins, one pull request.",
      "matchManagers": ["nuget"],
      "matchDepTypes": ["dotnet-sdk"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": ".NET SDK",
      "groupSlug": "net-sdk"
    },
    {
      "description": "0055-F4 B-004: local tool manifest minor and patch updates, one pull request.",
      "matchManagers": ["nuget"],
      "matchFileNames": [".config/dotnet-tools.json"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "dotnet local tools",
      "groupSlug": "dotnet-local-tools"
    },
    {
      "description": "0055-F4 B-012: give each .NET major update its own pull request.",
      "matchManagers": ["nuget"],
      "matchUpdateTypes": ["major"],
      "groupName": null,
      "groupSlug": null
    },
    {
      "description": "0055-F4 C-4: a version is changed only where it is declared once.",
      "matchManagers": ["nuget"],
      "matchFileNames": ["!Directory.Packages.props", "!global.json", "!.config/dotnet-tools.json"],
      "enabled": false
    },
    {
      "description": "0055-F4 C-1, B-008: the engine's three dependencies stay on the baseline dependency versions. Lifted only by a change after 0001-F1 B-004's golden baseline test is on main that also amends 0001-F1 C-7.",
      "matchPackageNames": ["Markdig", "YamlDotNet", "JsonSchema.Net"],
      "enabled": false
    }
  ]
}
