{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "ignorePaths": [".github/workflows/**"],
  "timezone": "America/Chicago",
  "schedule": ["before 6am on monday"],
  "labels": ["dependencies", "📦 dependencies"],
  "dependencyDashboard": false,
  "nuget": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [".build/SpechtBuild.*.cs"],
      "matchStrings": ["(?:\\bUses|\\bconst string \\w+Action)\\s*=\\s*\"(?<depName>[\\w.-]+/[\\w.-]+)@(?<currentValue>v[\\d.]+(?:-[\\w.-]+)?)\""],
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "github-actions"
    }
  ],
  "packageRules": [
    {
      "description": "0055-F4 B-001: NuGet minor and patch updates in Directory.Packages.props, one pull request.",
      "matchManagers": ["nuget"],
      "matchFileNames": ["Directory.Packages.props"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "NuGet packages",
      "groupSlug": "nuget-packages"
    },
    {
      "description": "0055-F4 B-003: the .NET SDK global.json pins, one pull request.",
      "matchManagers": ["nuget"],
      "matchDepTypes": ["dotnet-sdk"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": ".NET SDK",
      "groupSlug": "net-sdk"
    },
    {
      "description": "0055-F4 B-004: local tool manifest minor and patch updates, one pull request.",
      "matchManagers": ["nuget"],
      "matchFileNames": [".config/dotnet-tools.json"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "dotnet local tools",
      "groupSlug": "dotnet-local-tools"
    },
    {
      "description": "0055-F4 B-002: GitHub Actions minor and patch updates, one pull request.",
      "matchManagers": ["custom.regex"],
      "matchFileNames": [".build/SpechtBuild.*.cs"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions"
    },
    {
      "description": "0055-F4 B-012: give each major update its own pull request.",
      "matchUpdateTypes": ["major"],
      "groupName": null,
      "groupSlug": null
    },
    {
      "description": "0055-F4 B-009, B-013: regenerate workflows once after all action declarations in the branch are updated.",
      "matchManagers": ["custom.regex"],
      "matchFileNames": [".build/SpechtBuild.*.cs"],
      "postUpgradeTasks": {
        "commands": ["bash .github/renovate-regenerate-workflows.sh"],
        "fileFilters": [".github/workflows/*.yml"],
        "executionMode": "branch"
      }
    },
    {
      "description": "0055-F4 B-014: regenerate workflows when the build generator changes.",
      "matchManagers": ["nuget"],
      "matchFileNames": ["Directory.Packages.props"],
      "matchPackageNames": ["Nuke.Common", "Rocket.Surgery.Nuke"],
      "postUpgradeTasks": {
        "commands": ["bash .github/renovate-regenerate-workflows.sh"],
        "fileFilters": [".github/workflows/*.yml"]
      }
    },
    {
      "description": "0055-F4 C-4: a version is changed only where it is declared once.",
      "matchManagers": ["nuget"],
      "matchFileNames": ["!Directory.Packages.props", "!global.json", "!.config/dotnet-tools.json"],
      "enabled": false
    },
    {
      "description": "0055-F4 C-1, B-008: the engine's three dependencies stay on the baseline dependency versions. Lifted only by a change after 0001-F1 B-004's golden baseline test is on main that also amends 0001-F1 C-7.",
      "matchPackageNames": ["Markdig", "YamlDotNet", "JsonSchema.Net"],
      "enabled": false
    }
  ]
}
