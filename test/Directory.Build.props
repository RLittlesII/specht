<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- xunit.v3 self-hosts on Microsoft.Testing.Platform; nothing else sets OutputType for it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <!-- The test targets ask every test project for coverage (0055-F3 B-001); a project without the extension rejects the option. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
  </ItemGroup>

  <PropertyGroup>
    <TestingPlatformCommandLineArguments>$(TestingPlatformCommandLineArguments) --coverage-output $(MSBuildProjectName).coverage.cobertura.xml</TestingPlatformCommandLineArguments>
  </PropertyGroup>

  <!-- The tier guard, in every *tests project and not in acceptance (specht-conventions § Testing). -->
  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('tests', StringComparison.OrdinalIgnoreCase))">
    <Compile Include="$(MSBuildThisFileDirectory)Shared/TestTierGovernanceTests.cs" Link="Shared/TestTierGovernanceTests.cs" />
  </ItemGroup>

</Project>
