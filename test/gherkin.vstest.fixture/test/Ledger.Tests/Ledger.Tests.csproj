<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net$(BundledNETCoreAppTargetFrameworkVersion)</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Ledger/Ledger.csproj" />
    <Compile Include="../shared/ReversalTests.cs" Link="Shared/ReversalTests.cs" />
    <Compile Include="../shared/PendingTests.cs" Link="Shared/PendingTests.cs" />
  </ItemGroup>
  <ItemGroup>
    <SpechtTestEvidence Include="obj/specht-test-evidence/$(MSBuildProjectName)-$(TargetFramework).json"
                        Condition="Exists('obj/specht-test-evidence/$(MSBuildProjectName)-$(TargetFramework).json')" />
  </ItemGroup>
</Project>
