<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ReqnrollUseIntermediateOutputPathForCodeBehind>true</ReqnrollUseIntermediateOutputPathForCodeBehind>
  </PropertyGroup>

  <!-- One literal entry per linked .feature file; a batched glob silently discovers zero tests (specht-conventions § Testing). -->
  <ItemGroup>
    <ReqnrollFeatureFile Include="..\..\src\specht\.spec\engine.feature" Link="Features\engine.feature" />
    <ReqnrollFeatureFile Include="..\..\src\specht.tool\Features\Check\.spec\check.feature" Link="Features\check.feature" />
    <ReqnrollFeatureFile Include="..\..\src\specht.tool\Features\Init\.spec\init.feature" Link="Features\init.feature" />
    <ReqnrollFeatureFile Include="..\..\src\specht\Discovery\.spec\discovery.feature" Link="Features\discovery.feature" />
    <ReqnrollFeatureFile Include="..\..\src\specht\Manifest\.spec\manifest.feature" Link="Features\manifest.feature" />
    <ReqnrollFeatureFile Include="..\..\src\specht\Report\.spec\report.feature" Link="Features\report.feature" />
    <ReqnrollFeatureFile Include="..\..\src\specht.tool\.spec\versioning.feature" Link="Features\versioning.feature" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Reqnroll.xunit.v3" />
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Spectre.Console.Cli.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\specht\specht.csproj" />
    <ProjectReference Include="..\..\src\specht.tool\specht.tool.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- The check's scenarios build their trees with the engine tests' fixture, over the live schema set it copies from the
       output (specht-conventions § Testing: fixtures are built, not copied). -->
  <ItemGroup>
    <Compile Include="..\specht.tests\SpecTree.cs" Link="Check\SpecTree.cs" />
    <!-- The baseline tree and its golden report (0001-F1 B-004, C-10), the same files the engine tests read. -->
    <Compile Include="..\specht.tests\Baseline\BaselineTree.cs" Link="Engine\BaselineTree.cs" />
    <Compile Include="..\specht.tests\Baseline\GoldenReport.cs" Link="Engine\GoldenReport.cs" />
    <!-- The engine's built library and the references that would let the machine reach a verdict (B-005, B-006). -->
    <Compile Include="..\specht.tests\EngineAssembly.cs" Link="Engine\EngineAssembly.cs" />
    <Content Include="..\specht.tests\Baseline\engine-e7dba24.json"
             Link="Baseline\engine-e7dba24.json"
             CopyToOutputDirectory="PreserveNewest" />
    <!-- The fixture is hooked's, copied unchanged (0001-F1 C-2), and leans on implicit usings; these are the ones it reads. -->
    <Using Include="System" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.IO" />
    <Using Include="System.Linq" />
    <Content Include="..\..\.spec\schema\*.json"
             Link=".spec\schema\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\.spec\templates\feature.md;..\..\.spec\templates\decision.md;..\..\.spec\templates\adr.md;..\..\.spec\templates\lesson.md"
             Link=".spec\templates\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\docs\schema\*.json"
             Link="docs\schema\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
