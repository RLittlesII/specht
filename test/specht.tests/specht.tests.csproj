<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Spectre.Console.Cli.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\specht\specht.csproj" />
    <ProjectReference Include="..\..\src\specht.tool\specht.tool.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- The live schema set, copied into the output as hooked's test project did: the tests run against the contract the
       rules enforce, not a fixture copy of it. -->
  <ItemGroup>
    <Content Include="..\..\.spec\schema\*.json"
             Link=".spec\schema\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
