<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- CS8669: AutoFixtures 10.0.6 emits AutoFixtureBase.g.cs with nullable annotations and no #nullable directive. Only
         generated code raises it, an .editorconfig section does not reach a generated tree, and only the package can fix
         it; drop this when it does. -->
    <NoWarn>$(NoWarn);CS8669</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Spectre.Console.Cli.Testing" />
    <PackageReference Include="Rocket.Surgery.Extensions.Testing.AutoFixtures" />
    <PackageReference Include="TestableIO.System.IO.Abstractions.TestingHelpers" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\specht\specht.csproj" />
    <ProjectReference Include="..\..\src\specht.tool\specht.tool.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- The live schema set, copied into the output as hooked's test project did: the tests run against the contract the
       rules enforce, not a fixture copy of it. -->
  <ItemGroup>
    <Content Include="..\..\.spec\schema\*.json"
             Link=".spec\schema\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
