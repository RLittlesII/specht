<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ReqnrollUseIntermediateOutputPathForCodeBehind>true</ReqnrollUseIntermediateOutputPathForCodeBehind>
    <RootNamespace>Specht.Acceptance</RootNamespace>
    <AssemblyName>specht.acceptance</AssemblyName>
  </PropertyGroup>

  <!-- One literal entry per linked .feature file; a batched glob silently discovers zero tests (specht-conventions § Testing). -->
  <ItemGroup>
    <ReqnrollFeatureFile Include="../../src/analyzers/Bindings/.spec/bindings.feature" Link="Features/analyzers-bindings.feature" />
    <ReqnrollFeatureFile Include="../../src/CodeFixes/.spec/csharp.feature" Link="Features/codefixes-csharp.feature" />
    <ReqnrollFeatureFile Include="../../src/analyzers/TestEvidence/.spec/tests.feature" Link="Features/analyzers-test-evidence.feature" />
    <ReqnrollFeatureFile Include="../../src/analyzers/Scenarios/.spec/scenarios.feature" Link="Features/analyzers-scenarios.feature" />
    <ReqnrollFeatureFile Include="../../src/analyzers/Reconciliation/.spec/reconciliation.feature" Link="Features/analyzers-reconciliation.feature" />
    <ReqnrollFeatureFile Include="../../src/CodeAnalysis/.spec/adoption.feature" Link="Features/codeanalysis-adoption.feature" />

    <ReqnrollFeatureFile Include="../../.config/.spec/consuming-the-package.feature" Link="Features/consuming-the-package.feature" />
    <ReqnrollFeatureFile Include="../../.performance/comparison/.spec/baseline-comparison.feature" Link="Features/baseline-comparison.feature" />
    <ReqnrollFeatureFile Include="..\..\src\specht\.spec\engine.feature" Link="Features\engine.feature" />
    <ReqnrollFeatureFile Include="..\..\src\specht\Discovery\.spec\discovery.feature" Link="Features\discovery.feature" />
    <ReqnrollFeatureFile Include="..\..\src\specht\Manifest\.spec\manifest.feature" Link="Features\manifest.feature" />
    <ReqnrollFeatureFile Include="../../src/specht/Rules/Matrix/.spec/matrix-resolution.feature" Link="Features/matrix-resolution.feature" />
    <ReqnrollFeatureFile Include="..\..\src\specht\Report\.spec\report.feature" Link="Features\report.feature" />
    <ReqnrollFeatureFile Include="..\..\.build\Versioning\.spec\versioning.feature" Link="Features\package-versioning.feature" />
    <ReqnrollFeatureFile Include="..\..\src\tool\.spec\versioning.feature" Link="Features\versioning.feature" />
    <ReqnrollFeatureFile Include="..\..\src\tool\Features\Check\.spec\check.feature" Link="Features\check.feature" />
    <ReqnrollFeatureFile Include="..\..\src\tool\Features\Init\.spec\init.feature" Link="Features\init.feature" />
    <ReqnrollFeatureFile Include="../../src/tool/Features/Frontmatter/.spec/frontmatter.feature" Link="Features/frontmatter.feature" />
    <ReqnrollFeatureFile Include="..\..\docs\.spec\docs-as-first-class-citizen.feature" Link="Features\docs-as-first-class-citizen.feature" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Reqnroll.xunit.v3" />
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Spectre.Console.Cli.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\specht\specht.csproj" />
    <ProjectReference Include="../../src/analyzers/analyzers.csproj" />
    <ProjectReference Include="../../.performance/comparison/comparison.csproj" />
    <ProjectReference Include="..\..\src\tool\tool.csproj" />
    <ProjectReference Include="..\..\.build\.build.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- The check's scenarios build their trees with the engine tests' fixture, over the live schema set it copies from the
       output (specht-conventions § Testing: fixtures are built, not copied). -->
  <ItemGroup>
    <!-- The baseline tree and its golden report (0001-F1 B-004, C-10), the same files the engine tests read. -->
    <!-- The engine's built library and the references that would let the machine reach a verdict (B-005, B-006). -->
    <!-- The reader the rule page tests and steps share (0001-F3 B-032, B-033). -->
    <!-- The engine as AddSpechtEngine() registers it (item 0107), which the fixture's run and the steps resolve the runner and the model loader from. -->
    <Compile Include="..\tests\Engine\Baseline\BaselineTree.cs">
      <Link>Engine\BaselineTree.cs</Link>
    </Compile>
    <Compile Include="..\tests\Engine\Baseline\GoldenReport.cs">
      <Link>Engine\GoldenReport.cs</Link>
    </Compile>
    <Compile Include="..\tests\Shared\EngineAssembly.cs">
      <Link>Engine\EngineAssembly.cs</Link>
    </Compile>
    <Compile Include="..\tests\Shared\EngineServices.cs">
      <Link>Engine\EngineServices.cs</Link>
    </Compile>
    <Compile Include="..\tests\Rules\RulePage.cs">
      <Link>Rules\RulePage.cs</Link>
    </Compile>
    <Compile Include="..\tests\Shared\SpecTree.cs">
      <Link>Check\SpecTree.cs</Link>
    </Compile>
    <Content Include="..\tests\Engine\Baseline\engine-e7dba24.json">
      <Link>Baseline\engine-e7dba24.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- The imported fixture relies on these implicit usings (0001-F1 C-2). -->
    <Using Include="System" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.IO" />
    <Using Include="System.Linq" />
    <Content Include="..\..\.specht\**\*.json"
             Link=".specht\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\.specht\templates\feature.md;..\..\.specht\templates\decision.md;..\..\.specht\templates\adr.md;..\..\.specht\templates\lesson.md"
             Link=".specht\templates\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\docs\schema\*.json"
             Link="docs\schema\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <!-- The pages the command-line reference's scenarios read, at their repository-relative paths (0002-F1 B-003, B-006 to B-011). -->
    <Content Include="..\..\docs\*.md"
             Link="docs\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../.config/dotnet-tools.json" Link="Consumption/dotnet-tools.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../nuget.config" Link="Consumption/nuget.config" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\README.md"
             Link="README.md"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\tool\README.md"
             Link="src\tool\README.md"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
