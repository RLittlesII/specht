<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks />
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>Specht.Analysis</RootNamespace>
    <AssemblyName>Specht.Analysis</AssemblyName>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="JsonPointer.Net" />
    <PackageReference Include="Microsoft.CodeAnalysis.Common" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="System.Text.Json" />
    <PackageReference Include="Specht.CodeAnalysis" PrivateAssets="all" Condition="'$(SpechtCodeAnalysisPackageVersion)' != ''" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../specht/Model/FrontmatterTextReader.cs" Link="Text/FrontmatterTextReader.cs" />
    <Compile Include="../specht/Model/FrontmatterText.cs" Link="Text/FrontmatterText.cs" />
    <Compile Include="../specht/Model/MarkdownTextReader.cs" Link="Text/MarkdownTextReader.cs" />
    <Compile Include="../specht/Model/MarkdownTextSection.cs" Link="Text/MarkdownTextSection.cs" />
    <Compile Include="../specht/Model/GherkinClaimTextReader.cs" Link="Text/GherkinClaimTextReader.cs" />
    <Compile Include="../specht/Model/GherkinClaimTagForm.cs" Link="Text/GherkinClaimTagForm.cs" />
    <Compile Include="../specht/Model/GherkinClaimTags.cs" Link="Text/GherkinClaimTags.cs" />
    <Compile Include="../specht/Model/GherkinClaimText.cs" Link="Text/GherkinClaimText.cs" />
    <Compile Include="../specht/Model/GherkinClaimDeclaration.cs" Link="Text/GherkinClaimDeclaration.cs" />
    <Compile Include="../specht/Model/GherkinClaimElement.cs" Link="Text/GherkinClaimElement.cs" />
    <Compile Include="../specht/Model/GherkinClaimCaseLine.cs" Link="Text/GherkinClaimCaseLine.cs" />
    <Compile Include="../specht/Model/GherkinClaimTextFinding.cs" Link="Text/GherkinClaimTextFinding.cs" />
    <Compile Include="../specht/Model/GherkinClaimTextException.cs" Link="Text/GherkinClaimTextException.cs" />
  </ItemGroup>
</Project>
