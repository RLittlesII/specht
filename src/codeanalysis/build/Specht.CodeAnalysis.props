<Project>
  <PropertyGroup>
    <SpechtRoot Condition="'$(SpechtRoot)' == ''">$([MSBuild]::GetDirectoryNameOfFileAbove('$(MSBuildProjectDirectory)', '.specht/manifest.json'))</SpechtRoot>
    <SpechtRoot Condition="'$(SpechtRoot)' != ''">$([System.IO.Path]::GetFullPath('$(SpechtRoot)'))</SpechtRoot>
    <SpechtProjectPath Condition="'$(SpechtRoot)' != '' and '$(SpechtProjectPath)' == ''">$([System.IO.Path]::GetRelativePath('$(SpechtRoot)', '$(MSBuildProjectFullPath)'))</SpechtProjectPath>
    <SpechtFeatureInputs Condition="'$(SpechtFeatureInputs)' == ''">$(SpechtRoot)/**/.spec/README.md;$(SpechtRoot)/epics/**/spec.md</SpechtFeatureInputs>
    <SpechtScenarioInputs Condition="'$(SpechtScenarioInputs)' == ''">$(SpechtRoot)/**/.spec/*.feature;$(SpechtRoot)/epics/**/*.feature;$(SpechtRoot)/.spec/features/**/*.feature</SpechtScenarioInputs>
    <SpechtAdrInputs Condition="'$(SpechtAdrInputs)' == ''">$(SpechtRoot)/**/.spec/adr/**/*.md;$(SpechtRoot)/epics/**/adr/**/*.md</SpechtAdrInputs>
    <SpechtInputExclude>$(SpechtRoot)/.artifacts/**;$(SpechtRoot)/.claude/**;$(SpechtRoot)/.codex/**;$(SpechtRoot)/.git/**;$(SpechtRoot)/**/bin/**;$(SpechtRoot)/**/obj/**;$(SpechtRoot)/**/node_modules/**</SpechtInputExclude>
  </PropertyGroup>

  <ItemGroup Condition="'$(SpechtRoot)' != ''">
    <Analyzer Include="$(MSBuildThisFileDirectory)../analyzers/dotnet/cs/*.dll" />
    <Analyzer Remove="$(MSBuildThisFileDirectory)../analyzers/dotnet/cs/Microsoft.CodeAnalysis.dll;$(MSBuildThisFileDirectory)../analyzers/dotnet/cs/Microsoft.CodeAnalysis.CSharp.dll" />
    <AdditionalFiles Include="$(SpechtRoot)/.specht/manifest.json" Condition="Exists('$(SpechtRoot)/.specht/manifest.json')">
      <SpechtInputKind>configuration</SpechtInputKind>
      <SpechtRelativePath>.specht/manifest.json</SpechtRelativePath>
    </AdditionalFiles>
    <AdditionalFiles Include="$(SpechtFeatureInputs)" Exclude="$(SpechtInputExclude)">
      <SpechtInputKind>feature</SpechtInputKind>
      <SpechtRelativePath>$([System.IO.Path]::GetRelativePath('$(SpechtRoot)', '%(FullPath)'))</SpechtRelativePath>
    </AdditionalFiles>
    <AdditionalFiles Include="$(SpechtScenarioInputs)" Exclude="$(SpechtInputExclude)">
      <SpechtInputKind>scenario</SpechtInputKind>
      <SpechtRelativePath>$([System.IO.Path]::GetRelativePath('$(SpechtRoot)', '%(FullPath)'))</SpechtRelativePath>
    </AdditionalFiles>
    <AdditionalFiles Include="$(SpechtAdrInputs)" Exclude="$(SpechtInputExclude)">
      <SpechtInputKind>adr</SpechtInputKind>
      <SpechtRelativePath>$([System.IO.Path]::GetRelativePath('$(SpechtRoot)', '%(FullPath)'))</SpechtRelativePath>
    </AdditionalFiles>
    <AdditionalFiles Include="$(SpechtRoot)/.specht/schema/**/*.json">
      <SpechtInputKind>schema:$([System.String]::Copy('%(Filename)').Replace('.schema', ''))</SpechtInputKind>
      <SpechtRelativePath>$([System.IO.Path]::GetRelativePath('$(SpechtRoot)', '%(FullPath)'))</SpechtRelativePath>
    </AdditionalFiles>
    <CompilerVisibleProperty Include="SpechtRoot" />
    <CompilerVisibleProperty Include="SpechtProjectPath" />
    <CompilerVisibleProperty Include="Configuration" />
    <CompilerVisibleProperty Include="TargetFramework" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="SpechtInputKind" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="SpechtRelativePath" />
  </ItemGroup>
</Project>
