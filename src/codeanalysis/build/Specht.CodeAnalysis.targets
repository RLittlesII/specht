<Project>
  <Target Name="SpechtCodeAnalysisValidateRoot" BeforeTargets="CoreCompile" Condition="'$(SpechtRoot)' == ''">
    <Warning Text="Specht.CodeAnalysis could not find .specht/manifest.json above '$(MSBuildProjectDirectory)'. Set SpechtRoot to the consumer repository root to enable analysis inputs." />
  </Target>

  <ItemGroup Condition="'$(SpechtRoot)' != ''">
    <AdditionalFiles Include="@(SpechtAdditionalRecords)">
      <SpechtRelativePath Condition="'%(SpechtRelativePath)' == ''">$([System.IO.Path]::GetRelativePath('$(SpechtRoot)', '%(FullPath)'))</SpechtRelativePath>
    </AdditionalFiles>
    <AdditionalFiles Include="@(SpechtTestEvidence)">
      <SpechtInputKind>test-evidence</SpechtInputKind>
      <SpechtRelativePath Condition="'%(SpechtRelativePath)' == ''">$([System.IO.Path]::GetRelativePath('$(SpechtRoot)', '%(FullPath)'))</SpechtRelativePath>
    </AdditionalFiles>
  </ItemGroup>

  <PropertyGroup>
    <SpechtTestEvidenceOutput Condition="'$(SpechtTestEvidenceOutput)' == ''">$(MSBuildProjectDirectory)/$(BaseIntermediateOutputPath)specht-test-evidence/$(MSBuildProjectName)-$(TargetFramework).json</SpechtTestEvidenceOutput>
    <SpechtTestEvidenceOutput>$([System.IO.Path]::GetFullPath('$(SpechtTestEvidenceOutput)').Replace('\', '/'))</SpechtTestEvidenceOutput>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsTestingPlatformApplication)' == 'true'">
    <Reference Include="$(MSBuildThisFileDirectory)runner/$(TargetFramework)/*.dll"
               Condition="Exists('$(MSBuildThisFileDirectory)runner/$(TargetFramework)/Specht.TestEvidence.Mtp.dll')" />
    <TestingPlatformBuilderHook Include="D8CB5E70-324E-42A5-9A61-75B6D2AC1084">
      <DisplayName>Specht test evidence</DisplayName>
      <TypeFullName>Specht.TestEvidence.Mtp.TestEvidenceBuilderHook</TypeFullName>
    </TestingPlatformBuilderHook>
  </ItemGroup>

  <PropertyGroup Condition="'$(IsTestProject)' == 'true' and '$(IsTestingPlatformApplication)' != 'true' and '$(SpechtRoot)' != '' and '$(TargetPath)' != ''">
    <SpechtVsTestLoggerDirectory>$(MSBuildThisFileDirectory)vstest/net$(BundledNETCoreAppTargetFrameworkVersion)</SpechtVsTestLoggerDirectory>
    <SpechtVsTestLoggerDirectory Condition="!Exists('$(SpechtVsTestLoggerDirectory)/Specht.TestEvidence.VsTest.TestLogger.dll')">$(MSBuildThisFileDirectory)vstest/net10.0</SpechtVsTestLoggerDirectory>
    <VSTestTestAdapterPath Condition="'$(VSTestTestAdapterPath)' == ''">$(SpechtVsTestLoggerDirectory)</VSTestTestAdapterPath>
    <VSTestTestAdapterPath Condition="'$(VSTestTestAdapterPath)' != '$(SpechtVsTestLoggerDirectory)'">$(VSTestTestAdapterPath);$(SpechtVsTestLoggerDirectory)</VSTestTestAdapterPath>
    <VSTestLogger Condition="'$(VSTestLogger)' == ''">specht</VSTestLogger>
    <VSTestLogger Condition="'$(VSTestLogger)' != 'specht'">$(VSTestLogger);specht</VSTestLogger>
  </PropertyGroup>

  <Target Name="SpechtTestEvidenceWriteRunnerConfig" AfterTargets="Build"
          Condition="('$(IsTestingPlatformApplication)' == 'true' or '$(SpechtVsTestLoggerDirectory)' != '') and '$(SpechtRoot)' != '' and '$(TargetPath)' != ''">
    <PropertyGroup>
      <SpechtTestEvidenceAssemblyPath>$([System.IO.Path]::GetRelativePath('$(SpechtRoot)', '$(TargetPath)').Replace('\', '/'))</SpechtTestEvidenceAssemblyPath>
    </PropertyGroup>
    <MakeDir Directories="$(TargetDir)" />
    <WriteLinesToFile File="$(TargetDir)specht.test-evidence.config.json"
                      Lines="{ &quot;outputPath&quot;: &quot;$(SpechtTestEvidenceOutput)&quot;, &quot;assemblyPath&quot;: &quot;$(SpechtTestEvidenceAssemblyPath)&quot; }"
                      Overwrite="true" />
  </Target>
</Project>
