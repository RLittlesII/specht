<Project Sdk="Microsoft.NET.Sdk">

  <!-- The one project that packs: NuGet package specht.tool, command specht. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>specht</ToolCommandName>
    <PackageId>specht.tool</PackageId>
    <RootNamespace>Specht.Tool</RootNamespace>
    <AssemblyName>specht.tool</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <Description>A dotnet tool that checks a repository's specification documents against a versioned schema.</Description>
    <Authors>Rodney Littles, II</Authors>
    <Copyright>Copyright (c) 2026 Rodney Littles, II</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/RLittlesII/specht</PackageProjectUrl>
    <RepositoryUrl>https://github.com/RLittlesII/specht</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>https://github.com/RLittlesII/specht/releases</PackageReleaseNotes>
    <PackageTags>specification spec-driven-development traceability gherkin dotnet-tool</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>specht-book-avatar.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="README.md" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\.assets\logos\specht-book-avatar.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console.Cli" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\specht\specht.csproj" />
  </ItemGroup>

  <!-- The shipping copy (0001-F4 C-2), one folder per schema version, named manifest/v<major.minor.patch>/manifest.json,
       schema/v<major.minor.patch>/frontmatter/<file> and templates/v<major.minor.patch>/<file>. -->
  <ItemGroup>
    <EmbeddedResource Include="manifest\v*\manifest.json"
                      LogicalName="manifest/$([MSBuild]::ValueOrDefault('%(RecursiveDir)', '').Replace('\', '/'))%(Filename)%(Extension)" />
    <EmbeddedResource Include="schema\v*\**\*.json"
                      LogicalName="schema/$([MSBuild]::ValueOrDefault('%(RecursiveDir)', '').Replace('\', '/'))%(Filename)%(Extension)" />
    <EmbeddedResource Include="templates\v*\*.md"
                      LogicalName="templates/$([MSBuild]::ValueOrDefault('%(RecursiveDir)', '').Replace('\', '/'))%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
