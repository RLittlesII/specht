<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Specht</RootNamespace>
    <AssemblyName>specht</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="TestableIO.System.IO.Abstractions.Wrappers" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <!-- The first solution compile produces this checkout's analyzer package; CodeAnalysis then sets its exact version. -->
    <PackageReference Include="Specht.CodeAnalysis" PrivateAssets="all" Condition="'$(SpechtCodeAnalysisPackageVersion)' != ''" />
  </ItemGroup>

  <!-- The default manifest (0001-F5 A-4) is this repository's own manifest, embedded from that one file so it cannot
       drift from the copy the repository checks itself with. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\.specht\manifest.json"
                      Link=".specht\manifest.json"
                      LogicalName="specht.default-manifest.json" />
  </ItemGroup>

  <!-- B-048: omission defaults and init share each version's existing manifest source. -->
  <ItemGroup>
    <EmbeddedResource Include="..\tool\manifest\v*\manifest.json"
                      Link="manifest\%(RecursiveDir)%(Filename)%(Extension)"
                      LogicalName="manifest/$([MSBuild]::ValueOrDefault('%(RecursiveDir)', '').Replace('\', '/'))%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Every shipped version's frontmatter schemas (0001-F7 B-004), linked from the tool's shipping copy, not copied,
       under the same schema/v<major.minor.patch>/frontmatter/<file> names. -->
  <ItemGroup>
    <EmbeddedResource Include="..\tool\schema\v*\frontmatter\*.schema.json"
                      Link="schema\%(RecursiveDir)%(Filename)%(Extension)"
                      LogicalName="schema/$([MSBuild]::ValueOrDefault('%(RecursiveDir)', '').Replace('\', '/'))%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Every shipped version's rule pages (0001-F3 B-031, A-4), linked from docs/rules at the repository root and
       embedded as rules/v<major.minor.patch>/<file>, as the schemas are as schema/v<major.minor.patch>/<file>. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\docs\rules\v*\*.md"
                      Link="rules\%(RecursiveDir)%(Filename)%(Extension)"
                      LogicalName="rules/$([MSBuild]::ValueOrDefault('%(RecursiveDir)', '').Replace('\', '/'))%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
