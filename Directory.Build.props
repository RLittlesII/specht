<Project>

    <PropertyGroup>
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <IsPackable>false</IsPackable>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    </PropertyGroup>

    <!-- The baseline engine and tests require implicit usings (0001-F1 C-2);
         enable them for those two projects so the imported files compile unchanged. -->
    <PropertyGroup Condition="'$(MSBuildProjectName)' == 'specht' or '$(MSBuildProjectName)' == 'tests'">
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <PropertyGroup Condition="'$(SpechtCodeAnalysisDogfood)' == 'true' and '$(MSBuildProjectName)' == 'analyzers'">
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);1591</NoWarn>
        <SpechtFeatureInputs>$(MSBuildThisFileDirectory)src/analyzers/Bindings/.spec/README.md</SpechtFeatureInputs>
        <SpechtScenarioInputs>$(MSBuildThisFileDirectory)src/analyzers/Bindings/.spec/*.feature</SpechtScenarioInputs>
        <SpechtAdrInputs>$(MSBuildThisFileDirectory).spec/adr/0017-*.md</SpechtAdrInputs>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Rocket.Surgery.Airframe.CodeAnalysis" PrivateAssets="all"/>
        <PackageReference Include="Nerdbank.GitVersioning" PrivateAssets="all"/>
    </ItemGroup>
    <ItemGroup>
        <None Include="**\.spec\*.feature"/>
        <None Include="**\.spec\**\*.md"/>
        <None Include="**\.issue\**\*.yml"/>
    </ItemGroup>
</Project>
