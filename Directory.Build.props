<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Only src/specht.tool packs; it opts back in. -->
    <IsPackable>false</IsPackable>
    <!-- Makes the .editorconfig ":warning" severities real build warnings
         (promoted to errors by TreatWarningsAsErrors above) instead of
         suggestions a developer can ignore while the build stays green. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- Solution-wide analyzer, wired in from day one rather than per-project. -->
    <PackageReference Include="Rocket.Surgery.Airframe.CodeAnalysis" PrivateAssets="all" />
  </ItemGroup>

</Project>
