<Project>

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <IsPackable>false</IsPackable>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    </PropertyGroup>

    <!-- The baseline engine and tests require implicit usings (0001-F1 C-2);
         enable them for those two projects so the imported files compile unchanged. -->
    <PropertyGroup Condition="'$(MSBuildProjectName)' == 'specht' or '$(MSBuildProjectName)' == 'tests'">
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Rocket.Surgery.Airframe.CodeAnalysis" PrivateAssets="all"/>
        <PackageReference Include="Nerdbank.GitVersioning" PrivateAssets="all"/>
    </ItemGroup>
    <ItemGroup>
        <None Include="**\.spec\*.feature"/>
        <None Include="**\.spec\**\*.md"/>
        <None Include="**\.issue\**\*.yml"/>
    </ItemGroup>
</Project>
