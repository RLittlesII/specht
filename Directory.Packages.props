<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <SpechtRoslynVersion>5.9.0</SpechtRoslynVersion>
    <SpechtRoslynVersion Condition="$([MSBuild]::MakeRelative('$(MSBuildThisFileDirectory)', '$(MSBuildProjectDirectory)').StartsWith('test'))">5.9.0</SpechtRoslynVersion>
  </PropertyGroup>

  <ItemGroup Label="Analyzers">
    <PackageVersion Include="Roslynator.Analyzers" Version="5.0.1" />
    <PackageVersion Include="Roslynator.Formatting.Analyzers" Version="5.0.1" />
    <PackageVersion Include="Roslynator.CodeFixes" Version="5.0.1" />
    <PackageVersion Include="Rocket.Surgery.Airframe.CodeAnalysis" Version="0.12.1" />
    <PackageVersion Include="Specht.CodeAnalysis" Version="$(SpechtCodeAnalysisPackageVersion)" Condition="'$(SpechtCodeAnalysisPackageVersion)' != ''" />
  </ItemGroup>

  <ItemGroup Label="Engine">
    <PackageVersion Include="JsonSchema.Net" Version="9.4.0" />
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
    <PackageVersion Include="Markdig" Version="1.4.0" />
    <PackageVersion Include="TestableIO.System.IO.Abstractions.Wrappers" Version="22.3.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0" />
    <PackageVersion Include="Scrutor" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup Label="Compiler components">
    <PackageVersion Include="JsonPointer.Net" Version="7.0.4" />
    <PackageVersion Include="Microsoft.Testing.Platform" Version="2.5.2" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Common" Version="$(SpechtRoslynVersion)" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="$(SpechtRoslynVersion)" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="$(SpechtRoslynVersion)" />
    <PackageVersion Include="System.Text.Json" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup Label="Cli">
    <PackageVersion Include="Spectre.Console.Cli" Version="0.57.2" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup Label="Mcp">
    <PackageVersion Include="ModelContextProtocol" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup Label="Build">
    <PackageVersion Include="Nuke.Common" Version="10.1.0" />
    <PackageVersion Include="Nerdbank.GitVersioning" Version="3.10.94" />
    <PackageVersion Include="NuGet.Packaging" Version="8.0.0" />
    <PackageVersion Include="Rocket.Surgery.Nuke" Version="2.9.12"/>
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup Label="Spike 0236 only">
    <PackageVersion Include="Microsoft.Playwright.Xunit.v3" Version="1.64.1" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="xunit.v3.mtp-v2" Version="4.0.1" />
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <PackageVersion Include="Reqnroll.xunit.v3" Version="3.3.4" />
    <PackageVersion Include="Rocket.Surgery.Extensions.Testing.SourceGenerators" Version="11.0.1" />
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="Spectre.Console.Cli.Testing" Version="0.57.2" />
    <PackageVersion Include="Rocket.Surgery.Extensions.Testing.AutoFixtures" Version="11.0.1" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageVersion Include="TestableIO.System.IO.Abstractions.TestingHelpers" Version="23.0.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
  </ItemGroup>

  <ItemGroup Label="VSTest logger">
    <PackageVersion Include="Microsoft.TestPlatform.ObjectModel" Version="18.11.1" />
  </ItemGroup>

  <ItemGroup Label="VSTest evidence fixture only">
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.1" />
    <PackageVersion Include="Reqnroll.xUnit" Version="3.3.4" />
  </ItemGroup>

  <ItemGroup Label="Benchmarking">
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

</Project>
